Rule 21    print -> PRINT ABRECHAVES FRASE FECHACHAVES
Rule 22    condicional -> IF ABREPARENTESES condicao FECHAPARENTESES INICIOBLOCO comandos FIMBLOCO else
Rule 23    else -> ELSE condicional
Rule 24    else -> ELSE INICIOBLOCO comandos FIMBLOCO
Rule 25    else -> empty
Rule 26    repeticao_for -> FOR ABREPARENTESES atribuicao PONTOVIRGULA condicao PONTOVIRGULA atribuicao FECHAPARENTESES INICIOBLOCO comandos FIMBLOCO
Rule 27    repeticao_while -> WHILE ABREPARENTESES condicao FECHAPARENTESES INICIOBLOCO comandos FIMBLOCO
Rule 28    bloco -> INICIOBLOCO comandos FIMBLOCO
Rule 29    condicao -> condicao_logica
Rule 30    condicao -> condicao_relacional
Rule 31    condicao_logica -> condicao_logica AND condicao_logica
Rule 32    condicao_logica -> condicao_logica OR condicao_logica
Rule 33    condicao_logica -> NOT condicao
Rule 34    condicao_relacional -> VAR RELACIONAL VAR
Rule 35    condicao_relacional -> VAR RELACIONAL NUMERO
Rule 36    operacao -> VAR INCREMENTA
Rule 37    operacao -> VAR DECREMENTA
Rule 38    operacao -> VAR ARITMETICO VAR
Rule 39    operacao -> VAR ARITMETICO NUMERO
Rule 40    empty -> <empty>

